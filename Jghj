-- [ส่วนที่ 2: ระบบสร้างลูกศร 3 มิติ นีออนสีแดงปักลงจากฟ้า]
----------------------------------------------------------------
local function spawnArrowMarker(position)
	if not isPredictorEnabled then return end

	local oldArrow = Workspace:FindFirstChild("BallLandingArrow")
	if oldArrow then oldArrow:Destroy() end

	local arrowModel = Instance.new("Model")
	arrowModel.Name = "BallLandingArrow"

	-- 1. ก้านลูกศร
	local shaft = Instance.new("Part")
	shaft.Name = "Shaft"
	shaft.Shape = Enum.PartType.Cylinder
	shaft.Size = Vector3.new(5, 0.5, 0.5)
	shaft.Rotation = Vector3.new(0, 0, 90) -- ชี้ดิ่งลงพื้น
	shaft.Position = position + Vector3.new(0, 5, 0) -- ลอยเหนือจุดตกเพื่อชี้ลงมา
	shaft.Parent = arrowModel

	-- 2. หัวลูกศร (ทรงกรวย 3 มิติ)
	local cone = Instance.new("Part")
	cone.Name = "Cone"
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.FileMesh
	mesh.MeshId = "rbxassetid://1033717" -- รหัส Mesh ทรงกรวยสากลของ Roblox
	mesh.Scale = Vector3.new(2, 2, 2.5)
	mesh.Parent = cone
	cone.Size = Vector3.new(2, 2.5, 2)
	cone.Rotation = Vector3.new(180, 0, 0) -- คว่ำหัวลงดิน
	cone.Position = position + Vector3.new(0, 1.25, 0)
	cone.Parent = arrowModel

	-- ตั้งค่าเอฟเฟกต์สีและฟิสิกส์ให้ลูกศรทั้งหมด
	for _, part in pairs(arrowModel:GetChildren()) do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide = false
			part.CanTouch = false
			part.CanQuery = false
			part.Material = Enum.Material.Neon
			part.Color = Color3.fromRGB(255, 0, 0) -- สีแดงสดตามขอ
			part.Transparency = 0.2
		end
	end

	arrowModel.Parent = Workspace
	Debris:AddItem(arrowModel, 3) -- ลบลูกศรทิ้งเองใน 3 วินาทีเมื่อจบรอบ
end

----------------------------------------------------------------
-- [ส่วนที่ 3: ระบบดักวิถีโค้งฟิสิกส์ระดับสูง]
----------------------------------------------------------------
local function predictLanding(ball)
	if not isPredictorEnabled then return end
	
	local startPos = ball.Position
	local velocity = ball.AssemblyLinearVelocity
	local gravity = Workspace.Gravity

	-- ถ้าความเร็วต่ำเกินไป (บอลกลิ้งหรืออยู่นิ่ง) ปัดตกไม่ต้องคำนวณ
	if velocity.Magnitude < 10 then return end

	-- ใช้ Raycast ยิงลงดินตรวจหาความสูงพื้นสนามจริงแบบไดนามิก
	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	raycastParams.FilterDescendantsInstances = {ball, arrowModel}
	
	local rayResult = Workspace:Raycast(startPos, Vector3.new(0, -500, 0), raycastParams)
	local targetFloorY = rayResult and rayResult.Position.Y or DEFAULT_FLOOR_HEIGHT

	-- ใช้สูตรวิถีโค้งพาราโบลาถอดเวลา (t)
	local a = -0.5 * gravity
	local b = velocity.Y
	local c = startPos.Y - targetFloorY
	
	local discriminant = (b * b) - (4 * a * c)
	
	if discriminant >= 0 then
		local t = (-b - math.sqrt(discriminant)) / (2 * a)
		
		-- ตรวจสอบขอบเขตเวลาว่าสัมพันธ์กับจังหวะการตี
		if t > 0.02 and t < 5 then
			local finalX = startPos.X + (velocity.X * t)
			local finalZ = startPos.Z + (velocity.Z * t)
			local landingPosition = Vector3.new(finalX, targetFloorY, finalZ)
			
			-- สั่งจุดลูกศรแดงลงที่ตำแหน่งนั้นทันที
			spawnArrowMarker(landingPosition)
		end
	end
end

-- ฟังก์ชันเกาะจับลูกบอลและดักจับแรงปะทะใหม่ (ตรวจความถี่การเปลี่ยนทิศทางแบบ 3 มิติ)
local function trackBall(obj)
	-- ดักจับว่าตัวพาร์ทมีโอกาสเป็นลูกบอล (ทรงกลม หรือสัดส่วนเท่ากันทุกแกน)
	if obj:IsA("BasePart") and (obj.Shape == Enum.PartType.Ball or (obj.Size.X == obj.Size.Y and obj.Size.Y == obj.Size.Z)) then
		if obj.Name == "Terrain" or obj.Parent:IsA("Accessory") then return end
		
		local lastVelocity = obj.AssemblyLinearVelocity
		
		local connection
		connection = obj:GetPropertyChangedSignal("Position"):Connect(function()
			if not obj:IsDescendantOf(Workspace) then
				connection:Disconnect()
				return
			end
			
			local currentVelocity = obj.AssemblyLinearVelocity
			-- ตรวจหาแรงปะทะ (เมื่อเกิดการตบ, เสิร์ฟ, อันเดอร์ ความเร็วสะสมจะฉีกออกจากความเร็วเดิมกระทันหัน)
			if (currentVelocity - lastVelocity).Magnitude > 15 then
				RunService.Heartbeat:Wait() -- รอนิ่ง 1 เฟรมเพื่อให้เวกเตอร์ทิศทางจากเซิร์ฟเวอร์เสถียร
				predictLanding(obj)
			end
			lastVelocity = currentVelocity
		end)
	end
end

-- ลูปรันสแกนดักจับวัตถุในสนามทันทีที่เปิดสคริปต์
for _, obj in pairs(Workspace:GetDescendants()) do
	trackBall(obj)
end
Workspace.DescendantAdded:Connect(trackBall)

